[
  {
    "label": "CMake: Configure",
    "command": "cmake",
    "args": ["-S", ".", "-B", "build"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "CMake: Build",
    "command": "cmake",
    "args": ["--build", "build"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Run: webtrace",
    "command": ".\\build\\src\\Debug\\webtrace.exe",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
